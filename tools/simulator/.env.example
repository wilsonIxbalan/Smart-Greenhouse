# Copiar a .env (no se sube a git). Valores del proyecto Supabase del invernadero.
SUPABASE_URL=https://<project-ref>.supabase.co
# Project Settings → API Keys: publishable key (o la anon key legacy). Es pública por diseño.
SUPABASE_ANON_KEY=<publishable-o-anon-key>
DEVICE_ID=inv-01
# La que mostró supabase/sql/12_device_key.sql (columna llave_copiar_ahora)
DEVICE_KEY=<llave-del-dispositivo>
TELEMETRY_INTERVAL_MS=10000
COMMAND_POLL_MS=2500
